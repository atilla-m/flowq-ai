# Copy to .env.local (ignored by git). Everything here ends up in the public browser bundle,
# so NEVER put an API key in a frontend env file. The OpenAI key lives only in backend/.env.

# Backend base URL (FastAPI). In production this must be the deployed backend's https:// URL.
VITE_API_BASE=http://localhost:8000

# 1 = run the whole UI against built-in fake data (no backend, no OpenAI key needed)
VITE_MOCK=0
