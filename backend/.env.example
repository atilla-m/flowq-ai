OPENAI_API_KEY=
CHAT_MODEL=gpt-6.1-sol
VISION_MODEL=gpt-6.1-sol
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin
TRANSCRIPTION_MODEL=gpt-live-transcribe
INDUSTRY_PACK=gadgets
DATABASE_PATH=backend/data/flowq.sqlite3
UPLOAD_DIR=backend/data/media
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
PORT=8000

# Optional real telephone calls. Browser voice works without these.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_BASE_URL=
# Your actual E.164 number; maps only this caller to demo customer Aysel.
DEMO_CALLER_PHONE=
# Optional real WhatsApp for that same person. Also needs TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN,
# PUBLIC_BASE_URL and DEMO_CALLER_PHONE above (not TWILIO_PHONE_NUMBER).
# Sandbox sender is whatsapp:+14155238886; set the sandbox "when a message comes in" webhook to
# <PUBLIC_BASE_URL>/api/twilio/whatsapp (POST).
TWILIO_WHATSAPP_FROM=
